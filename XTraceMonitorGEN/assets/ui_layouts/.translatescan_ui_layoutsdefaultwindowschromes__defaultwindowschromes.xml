<?xml version="1.0" encoding="UTF-8"?>
<layouts>
  <skin name="" drawmode="canvas" rasterfont="verdana18" vectorfont="Nunito-SemiBold.ttf" > </skin>

  <!-- GEN XML: start tags without attributes need a space before '>'. -->
  <fonts >
    <font name="default" file="Nunito-SemiBold.ttf"></font>
    <font name="cjk" file="NotoSansSC-Regular.otf"></font>
  </fonts>

  <languagefonts >
    <map language="chi" font="cjk"></map>
  </languagefonts>

  <color name="colortext">yellow</color>
  <color name="colormenuline">red</color>
  <color name="colormenu">black,50</color>

  <!--
    Default GEN custom window chrome (defaultwindowschromes.zip).

    Reusable by any app size: do NOT hardcode caption width. role="caption" resolves to the live canvas
    width in UI_SKINCANVAS::CalculateBoundaryLine_Form so xpos="right" language/min/max/close stay on the
    real right edge (WindowChromes 1024, UI_System 1440, etc.).

    Button margins are left,right,up,down — right margins keep 32px icons + ~4px gaps from the right edge:
      close    right=12
      maximize right=48   (12+32+4)
      minimize right=84   (12+32+4+32+4)
      language right=120  (12+32+4+32+4+32+4)  — to the LEFT of minimize
    Extra 6px vs the old right=6 stack keeps the rounded SVG plates off the window edge (no right clip).
  -->
  <layout name="chrome">

    <element name="caption" type="form" role="caption" xpos="0" ypos="40" height="40" color="black,0">

      <element type="button" name="btn_chrome_icon" role="icon" xpos="left" ypos="center" margin="12,0,0,0" >
        <element type="animation">
          <image width="40" height="40">icon_app.png</image>
        </element>
      </element>

      <element type="text" name="txt_chrome_title" role="title" xpos="left" ypos="center" sizefont="14" margin="65,0,0,0" color="#FFFFFFFF">Title</element>

      <element name="btn_chrome_language" role="language" type="multioption" xpos="right" ypos="center" margin="0,120,0,0">

        <element type="button" name="btn_chrome_language" role="language" selectablestatus="active">
          <element type="animation">
            <image width="32" height="32">icon_language_activated.svg</image>
          </element>
        </element>

        <element type="button" name="btn_chrome_language" role="language" selectablestatus="preselect">
          <element type="animation">
            <image width="32" height="32">icon_language_preselected.svg</image>
          </element>
        </element>

        <element type="button" name="btn_chrome_language" role="language" selectablestatus="selected">
          <element type="animation">
            <image width="32" height="32">icon_language_activated.svg</image>
          </element>
        </element>

        <element type="button" name="btn_chrome_language" role="language" selectablestatus="deactive">
          <element type="animation">
            <image width="32" height="32">icon_language_deactivated.svg</image>
          </element>
        </element>

      </element>

      <element name="btn_chrome_minimize" role="minimize" type="multioption" xpos="right" ypos="center" margin="0,84,0,0">

        <element type="button" name="btn_chrome_minimize" role="minimize" selectablestatus="active">
          <element type="animation" >
            <image width="32" height="32">icon_minimized_activated.svg</image>
          </element>
        </element>

        <element type="button" name="btn_chrome_minimize" role="minimize" selectablestatus="preselect">
          <element type="animation">
            <image width="32" height="32">icon_minimized_preselected.svg</image>
          </element>
        </element>

        <element type="button" name="btn_chrome_minimize" role="minimize" selectablestatus="selected">
          <element type="animation">
            <image width="32" height="32">icon_minimized_activated.svg</image>
          </element>
        </element>

        <element type="button" name="btn_chrome_minimize" role="minimize" selectablestatus="deactive">
          <element type="animation">
            <image width="32" height="32">icon_minimized_deactivated.svg</image>
          </element>
        </element>

      </element>

      <element name="btn_chrome_maximize" role="maximize" type="multioption" xpos="right" ypos="center" margin="0,48,0,0">

        <element type="button" name="btn_chrome_maximize" role="maximize" selectablestatus="active">
          <element type="animation">
            <image width="32" height="32">icon_maximized_activated.svg</image>
          </element>
        </element>

        <element type="button" name="btn_chrome_maximize" role="maximize" selectablestatus="preselect">
          <element type="animation">
            <image width="32" height="32">icon_maximized_preselected.svg</image>
          </element>
        </element>

        <element type="button" name="btn_chrome_maximize" role="maximize" selectablestatus="selected">
          <element type="animation">
            <image width="32" height="32">icon_maximized_activated.svg</image>
          </element>
        </element>

        <element type="button" name="btn_chrome_maximize" role="maximize" selectablestatus="deactive">
          <element type="animation">
            <image width="32" height="32">icon_maximized_deactivated.svg</image>
          </element>
        </element>

      </element>

      <element name="btn_chrome_close" role="close" type="multioption" xpos="right" ypos="center" margin="0,12,0,0">

        <element type="button" name="btn_chrome_close" role="close" selectablestatus="active">
          <element type="animation">
            <image width="32" height="32">icon_close_activated.svg</image>
          </element>
        </element>

        <element type="button" name="btn_chrome_close" role="close" selectablestatus="preselect">
          <element type="animation">
            <image width="32" height="32">icon_close_preselected.svg</image>
          </element>
        </element>

        <element type="button" name="btn_chrome_close" role="close" selectablestatus="selected">
          <element type="animation">
            <image width="32" height="32">icon_close_activated.svg</image>
          </element>
        </element>

        <element type="button" name="btn_chrome_close" role="close" selectablestatus="deactive">
          <element type="animation">
            <image width="32" height="32">icon_close_deactivated.svg</image>
          </element>
        </element>

      </element>

    </element>

  </layout>

</layouts>
